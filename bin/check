#!/usr/bin/env bash
# Run the invariants and export tests against each profile (batch).
# Fails if any run fails: the exit status is Emacs's, not grep's.
set -uo pipefail
# EMACS_CONFIG_ROOT selects the tree, as in launch.sh, so the tests can run
# against the tree Nix built rather than the checkout.
root=${EMACS_CONFIG_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}; cd "$root"
fail=0
run() { # profile test
  local out
  out=$(emacs -Q --batch -l "configs/$1/early-init.el" --eval '(package-activate-all)' \
          -l "configs/$1/init.el" -l "test/$2.el" 2>&1)
  local rc=$?
  printf '%s\n' "$out" | grep -E "^(ok|FAIL|Error|skip)"
  if [ $rc -ne 0 ]; then echo "FAIL $2 ($1): exit $rc"; fail=1; fi
}
for p in hebrew notes ide; do run $p invariants; done
run hebrew export-in-profile   # asserts the RTL direction, hebrew only
for p in hebrew notes; do
  for t in export-footnote-placement export-narrowed; do run $p $t; done
done
for p in hebrew; do run $p search-hebrew; done
for p in hebrew notes; do run $p bidi; done
for p in hebrew notes ide; do run $p terminal; done
for p in hebrew notes ide; do run $p orderless-toggle; done

# Daemon smoke test: what batch cannot see -- the daemon path launch.sh uses,
# a buffer shown in a window, redisplay. A throwaway daemon per profile on its
# own socket dir, so it cannot collide with the real emacs-<profile> servers.
smoke() { # profile
  local p=$1 rt out
  rt=$(mktemp -d)
  if ! XDG_RUNTIME_DIR=$rt emacs --init-directory="$root/configs/$p" \
         --daemon="check-$p" >/dev/null 2>&1; then
    echo "FAIL daemon ($p): did not start"; fail=1; rm -rf "$rt"; return
  fi
  out=$(XDG_RUNTIME_DIR=$rt emacsclient -s "check-$p" \
          --eval "(progn (load \"$root/test/daemon-smoke.el\" nil t) (my/daemon-smoke))" 2>&1)
  if [ "$p" = hebrew ] && [ "$out" = '"ok"' ] && command -v script >/dev/null; then
    # A real (tty) frame under a pty, so redisplay runs and the labels must
    # appear with no command typed.
    # vt100: no terminal queries to answer.
    TERM=vt100 XDG_RUNTIME_DIR=$rt timeout 20 script -qec "stty rows 40 cols 100; \
      emacsclient -s check-$p -t --eval '(my/daemon-smoke-shown \"$rt/labels\")'" \
      /dev/null </dev/null >/dev/null 2>&1
    [ "$(cat "$rt/labels" 2>/dev/null)" = 1 ] ||
      out="footnote label not built before the first command (got: $(cat "$rt/labels" 2>/dev/null))"
  fi
  # Skip kill-emacs-hook: it would save this daemon's history over the real one.
  XDG_RUNTIME_DIR=$rt emacsclient -s "check-$p" \
    --eval '(let (kill-emacs-hook) (kill-emacs))' >/dev/null 2>&1
  rm -rf "$rt"
  case $out in
    '"ok'*) echo "ok daemon ($p)" ;;
    *) echo "FAIL daemon ($p): $out"; fail=1 ;;
  esac
}
for p in hebrew notes ide; do smoke $p; done
exit $fail
