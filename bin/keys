#!/bin/sh
# List every global key: first the ones the profile defines, then built-in Emacs.
# usage: bin/keys <hebrew|notes|ide>
set -eu
root=$(cd "$(dirname "$0")/.." && pwd); cd "$root"
p=${1:?usage: bin/keys <hebrew|notes|ide>}
[ -f "configs/$p/init.el" ] || { echo "unknown profile: $p" >&2; exit 2; }
exec emacs -Q --batch -l "configs/$p/early-init.el" --eval '(package-activate-all)' \
  -l bin/keys.el --eval '(setq keys--before (keys--snapshot))' \
  -l "configs/$p/init.el" --eval "(keys-report \"$p\")" 2>/dev/null
